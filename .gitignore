# 虚拟环境（1 GB）
.venv/

# 派生数据：可由脚本重建，且含原数据集正文，不重新分发
# 注意：.gitignore 不支持行尾注释，注释必须单独成行
cache/emb/
cache/tasks.json
cache/holdout.json
cache/*.parquet

# 本地运行产物
out/*.log
out/power_*.txt
out/*.bak
__pycache__/
*.pyc
.DS_Store

# 任何形式的凭证，一律不进库
.env
.dev.vars
*.key
*.pem

# 业务数据与外部私有项目的脚本，一律不进公开仓库
# （这些脚本读 ~/projects/hybrid-leads 下的真实客户名单：公司名、决策人、联系方式）
leads_persona.py
probe_leads.py
out/leads_persona.json
out/probe_leads.json
